 estresse crônico e síndrome de burnout, ajudando profissionais a estabelecerem limites saudáveis.",availableTimes:it()},{id:"13",name:"Dra. Patrícia Lima",specialties:["Terapia Infantil e Adolescente","Transtornos Alimentares"],rating:5,img:"https://api.dicebear.com/7.x/micah/svg?seed=PatriciaLima&backgroundColor=e0f2fe",crp:"06/14141",about:"Acompanhamento de adolescentes com questões de autoimagem e transtornos alimentares, trabalhando a aceitação e o autocuidado.",availableTimes:it()},{id:"14",name:"Dr. Eduardo Costa",specialties:["Terapia Cognitivo Comportamental","Orientação Profissional"],rating:4.8,img:"https://api.dicebear.com/7.x/micah/svg?seed=EduardoCosta&backgroundColor=e0f2fe",crp:"06/15151",about:"Utilizo a TCC para auxiliar no desenvolvimento de carreira, tomada de decisões e superação de bloqueios profissionais.",availableTimes:it()},{id:"15",name:"Dra. Sofia Martins",specialties:["Depressão e Ansiedade","Terapia Familiar"],rating:4.9,img:"https://api.dicebear.com/7.x/micah/svg?seed=SofiaMartins&backgroundColor=e0f2fe",crp:"06/16161",about:"Acolhimento empático para quadros de depressão e ansiedade, integrando a família no processo terapêutico quando necessário.",availableTimes:it()}];function ys({message:u,onClose:o}){return z.useEffect(()=>{const d=setTimeout(o,3e3);return()=>clearTimeout(d)},[o]),s.jsxs("div",{className:"fixed bottom-6 right-6 z-[100] bg-green-50 text-green-800 px-6 py-4 rounded-2xl shadow-lg border border-green-200 flex items-center gap-3 animate-in slide-in-from-bottom-5 fade-in duration-300",children:[s.jsx(ir,{className:"text-green-500 shrink-0",size:24}),s.jsx("span",{className:"font-bold",children:u})]})}function Dm(){const{id:u}=Zm(),o=tt(),d=Qn(),r=o.pathname.includes("/dashboard"),{addConsulta:m}=Vn(),[h,v]=z.useState(!1),[b,p]=z.useState(null),[g,A]=z.useState(null),[S,H]=z.useState(null),[q,L]=z.useState(null),B=(P=>{switch(P){case"terapia-familiar":return{title:"Terapia Familiar",img:"/Terapia familiar.png",descriptio